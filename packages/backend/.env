# Server Configuration
PORT=4001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (SQLite)
DATABASE_URL=./data/lowcode3d.db

# File Storage
UPLOAD_DIR=./data/uploads
PUBLIC_URL_BASE=/uploads
MAX_FILE_SIZE=52428800

# CORS
CORS_ORIGIN=https://editor3d.nicowebgl.cn,http://localhost:3001,http://127.0.0.1:3001,http://127.0.0.1:3005
